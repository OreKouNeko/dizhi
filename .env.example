# dizhi 配置模板
#
# 复制成 .env 后按需填写。**不要提交 .env 本身**（已在 .gitignore 里）。
# 所有项都是可选的，不填会走中性默认值；代码里没有任何硬编码的路径或密钥。

# ---------------------------------------------------------------- 数据集
# 小范围数据：单个 parquet 文件的路径
DIZHI_DATA=

# 全国数据：分区数据集的通配符。按地理格子分区后才能让查询跳过无关数据块，
# 分区方法见 README「从零建库」。
DIZHI_NATION=

# DuckDB 溢写目录。默认放在系统临时目录。
# 注意：**不要指向只读目录或权限受限的位置**，否则查询一大就报
# "IO Error: Cannot open file"。
DIZHI_TMP=

# 默认报告输出路径
DIZHI_REPORT=report.txt

# ---------------------------------------------------------------- OSM 数据
DIZHI_PBF=
DIZHI_GEOFABRIK=https://download.geofabrik.de

# ---------------------------------------------------------------- 大模型解析（可选）
# 不填就走规则式解析器，完全离线可用。
DIZHI_LLM_API_KEY=
DIZHI_LLM_BASE_URL=https://api.deepseek.com
DIZHI_LLM_MODEL=deepseek-chat
DIZHI_LLM_TIMEOUT=60

# ---------------------------------------------------------------- 第三方地图 API（可选）
# 高德 Web 服务：控制台申请时**必须选「Web服务」类型**。
# 个人 key 的 QPS 限制很紧，客户端已内置限速与退避重试。
AMAP_KEY=

# 天地图：注意**服务器端 key 强制要求 Referer**，网页底图会 403，
# 详见 src/dizhi/providers/tianditu.py 与 tools/serve_map.py。
TIANDITU_TK=
TIANDITU_REFERER=http://lbs.tianditu.gov.cn/

# ---------------------------------------------------------------- 运行参数
DIZHI_THREADS=4
DIZHI_MEMORY=2GB
